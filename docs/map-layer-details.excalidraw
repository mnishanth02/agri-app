    {
      "id": "l3_price_text",
      "type": "text",
      "x": 80,
      "y": 833,
      "width": 620,
      "height": 85,
      "text": "💰 Processing Units (PU) Model\n   Free tier: 10,000 PU/month\n   1 PU = 512×512 px, 3 bands, 16-bit\n   100 acres × 1 NDVI scan ≈ 0.03 PU\n   100 acres × 4 scans/year ≈ 0.13 PU/year (well within free tier!)",
      "fontSize": 14,
      "fontFamily": 5,
      "textAlign": "left",
      "strokeColor": "#e67700",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
