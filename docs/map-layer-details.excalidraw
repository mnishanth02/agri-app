    {
      "id": "l1_tech",
      "type": "text",
      "x": 70,
      "y": 1475,
      "width": 640,
      "height": 130,
      "text": "Style:         arcgis/imagery/standard (photo only, no labels)\nImagery:       Maxar Vivid — 30cm urban, 50cm agri, 2.5m global\nIndia res:     30–50cm — field bunds visible at zoom 16\nRendering:     MapLibre GL JS v4.x (BSD 3-Clause, free)\nPlugin:        @esri/maplibre-arcgis (Apache 2.0, free)\nService:       ArcGIS Location Platform — Basemap Styles Service\nAccount:       ArcGIS Location Platform (free signup at developers.arcgis.com)",
      "fontSize": 14,
      "fontFamily": 5,
      "textAlign": "left",
      "strokeColor": "#343a40",
