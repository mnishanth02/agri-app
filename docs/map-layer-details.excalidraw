      "type": "text",
      "x": 70,
      "y": 635,
      "width": 200,
      "height": 20,
      "text": "── Technical Details ──",
      "fontSize": 13,
      "fontFamily": 5,
      "textAlign": "left",
      "strokeColor": "#e67700",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
