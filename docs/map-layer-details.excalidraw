    },
    {
      "id": "l3_tech",
      "type": "text",
      "x": 70,
      "y": 660,
      "width": 640,
      "height": 150,
      "text": "Service:       Copernicus Data Space — Sentinel Hub API\nNDVI source:   Sentinel-2 L2A — 10m resolution, B04 + B08 bands\ndpRVI source:  Sentinel-1 SAR GRD — C-band radar, 5m–20m res\nIndia revisit: S-2 every 5 days (3-sat) · S-1 every 6–12 days\nAPI type:      WMS → returns PNG tile for polygon bbox + date\nWMS URL:       sh.dataspace.copernicus.eu/ogc/wms/{INSTANCE_ID}\nRendering:     MapLibre GL JS — added as image source\nAccount:       Free at dataspace.copernicus.eu → Sentinel Hub Dashboard",
      "fontSize": 14,
      "fontFamily": 5,
      "textAlign": "left",
      "strokeColor": "#343a40",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "roughness": 1,
      "opacity": 100,
      "angle": 0,
      "groupIds": ["g_l3"],
      "boundElements": null,
      "seed": 3009,
      "version": 1,
      "versionNonce": 22,
      "isDeleted": false,
      "roundness": null,
      "locked": false,
      "link": null,
      "updated": 1700000000000
    },
