    {
      "id": "l4_tech",
      "type": "text",
      "x": 70,
      "y": 275,
      "width": 640,
      "height": 110,
      "text": "Drawing lib:   terra-draw + terra-draw-maplibre-gl-adapter (MIT)\nRendering:     MapLibre GL JS — geojson source with fill + line layers\nData format:   GeoJSON Feature<Polygon>\nStorage:       React state (prototype) → PostgreSQL + PostGIS (production)\nExternal svc:  None — entirely your own app's data and code",
      "fontSize": 14,
      "fontFamily": 5,
      "textAlign": "left",
      "strokeColor": "#343a40",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "roughness": 1,
