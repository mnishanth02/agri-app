{
  "name": "@viz-crop/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Fastify HTTP API for viz-crop.",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/main.ts",
    "start": "node --env-file-if-exists=.env dist/main.js",
    "build": "tsc -b",
    "typecheck": "tsc -b",
    "clean": "tsc -b --clean"
  },
  "dependencies": {
    "@fastify/cors": "^11.1.0",
    "@fastify/sensible": "^6.0.3",
    "@viz-crop/shared": "workspace:*",
    "fastify": "^5.7.0",
    "pino-pretty": "^13.1.1",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@types/node": "^22.10.10",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}
