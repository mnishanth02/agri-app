PORT=8080
DATABASE_URL=postgres://viz:viz@localhost:5432/viz_crop
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# EOSDA backend API key (Module 4.1). REQUIRED for the API to start.
# Get it from https://api-connect.eos.com/user-dashboard/ -> API keys.
# Sent to EOSDA via the `x-api-key` header — never exposed to the browser.
EOSDA_API_KEY=
# Clerk backend (Module 0.8). REQUIRED for the API to start.
# Get it from https://dashboard.clerk.com -> API Keys (Secret keys).
# The publishable key lives only in apps/web/.env (VITE_CLERK_PUBLISHABLE_KEY).
CLERK_SECRET_KEY=
