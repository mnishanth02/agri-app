{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "types": ["vite/client"],
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"],
      "@esri/maplibre-arcgis": [
        "./node_modules/@esri/maplibre-arcgis/dist/esm/types/src/MaplibreArcGIS"
      ]
    },
    "noEmit": true,
    "tsBuildInfoFile": "node_modules/.cache/tsc/web.tsbuildinfo"
  },
  "include": ["src/**/*", "vite.config.ts"]
}
