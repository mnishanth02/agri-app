# Base URL of the @viz-crop/api server. Required.
VITE_API_BASE_URL=http://localhost:8080

# ArcGIS / Esri location services API key (basemaps, geocoding). Optional in early phases.
VITE_ESRI_API_KEY=

# Clerk publishable key (frontend). Optional until Module 0.8 (auth) lands.
VITE_CLERK_PUBLISHABLE_KEY=
