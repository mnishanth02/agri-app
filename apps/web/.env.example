# Base URL of the @viz-crop/api server. Required.
VITE_API_BASE_URL=http://localhost:8080

# ArcGIS / Esri location services API key (basemaps, geocoding). REQUIRED from Module 2.1 onward.
# Get one from https://developers.arcgis.com -> API Keys; scope to Basemaps and restrict to localhost + your prod domain.
VITE_ESRI_API_KEY=

# Clerk publishable key (frontend). REQUIRED from Module 0.8 onward.
# Get one from https://dashboard.clerk.com -> API Keys. Must start with pk_test_ or pk_live_.
VITE_CLERK_PUBLISHABLE_KEY=
