{
  "name": "viz-crop",
  "private": true,
  "version": "0.0.1",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "pnpm -r run dev",
    "build": "pnpm -r run build",
    "test": "pnpm -r run test",
    "typecheck": "pnpm -r run typecheck",
    "format": "biome format --write .",
    "lint": "biome lint .",
    "check": "biome check --write .",
    "ci": "biome ci .",
    "db:migrate": "pnpm --filter @viz-crop/api db:migrate",
    "db:generate": "pnpm --filter @viz-crop/api db:generate",
    "db:studio": "pnpm --filter @viz-crop/api db:studio"
  },
  "devDependencies": {
    "@biomejs/biome": "2.2.4"
  }
}
